{
  "functions": {
    "api/chat.js": {
      "maxDuration": 90
    }
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "app.whattocook.life" }],
      "destination": "https://what-to-cookkk.lovable.app/",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/app", "destination": "/app.html" }
  ]
}
