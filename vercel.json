{
  "functions": {
    "api/chat.js": {
      "maxDuration": 90
    }
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "app.whattocook.life" }],
      "destination": "/launch",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/app", "destination": "/app.html" },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "whattocook.life" }],
      "destination": "/home.html"
    }
  ]
}
